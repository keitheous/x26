{
  "info": {
    "name": "Spaceship X26 — Passenger Resource Management System",
    "description": "Manual walkthrough of the API built so far: health check, passenger CRUD, resource provisioning, and tier-filtered resource discovery.\n\nSetup:\n1. `docker compose up -d`\n2. `npm run dev` — on a fresh DB this prints 3 crew-lead API keys to stdout, exactly once\n3. Paste one of those keys into the `crewLeadApiKey` collection variable below\n4. Run 'Create Passenger' first — it auto-captures `passengerId` and `passengerApiKey` for the rest of the requests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000", "type": "string", "description": "Base URL for the local dev server" },
    { "key": "crewLeadApiKey", "value": "", "type": "string", "description": "Paste a plaintext key from the server boot-time stdout output" },
    { "key": "passengerId", "value": "", "type": "string", "description": "Auto-captured by the Create Passenger request" },
    { "key": "passengerApiKey", "value": "", "type": "string", "description": "Auto-captured by the Create Passenger request" },
    { "key": "sleepingPodResourceId", "value": "", "type": "string", "description": "Auto-captured by the Provision Sleeping Pod request" },
    { "key": "luxuryO2PodResourceId", "value": "", "type": "string", "description": "Auto-captured by the Provision Luxury O2 Pod request" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Crew Lead — Passengers",
      "item": [
        {
          "name": "Create Passenger",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('passengerId', body.id);",
                  "pm.collectionVariables.set('passengerApiKey', body.apiKey);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Wick\",\n  \"membershipLevel\": \"GOLD\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/passengers", "host": ["{{baseUrl}}"], "path": ["passengers"] }
          },
          "response": []
        },
        {
          "name": "List Passengers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" }],
            "url": { "raw": "{{baseUrl}}/passengers", "host": ["{{baseUrl}}"], "path": ["passengers"] }
          },
          "response": []
        },
        {
          "name": "Upgrade Passenger to PLATINUM",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"membershipLevel\": \"PLATINUM\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/passengers/{{passengerId}}/membership",
              "host": ["{{baseUrl}}"],
              "path": ["passengers", "{{passengerId}}", "membership"]
            },
            "description": "Writes a membership_change audit row (fromLevel GOLD -> toLevel PLATINUM). Re-run 'View My Accessible Resources' afterward as the passenger — the Luxury O2 Pod should now show up too."
          },
          "response": []
        },
        {
          "name": "Downgrade Passenger to SILVER",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"membershipLevel\": \"SILVER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/passengers/{{passengerId}}/membership",
              "host": ["{{baseUrl}}"],
              "path": ["passengers", "{{passengerId}}", "membership"]
            },
            "description": "Run this after the upgrade above to see the reverse: another membership_change row is written (fromLevel PLATINUM -> toLevel SILVER), and re-running 'View My Accessible Resources' should show the Luxury O2 Pod disappearing again."
          },
          "response": []
        },
        {
          "name": "Deactivate Passenger",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/passengers/{{passengerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["passengers", "{{passengerId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Crew Lead — Resources",
      "item": [
        {
          "name": "Provision Sleeping Pod (SILVER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sleepingPodResourceId', pm.response.json().id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sleeping Pod A1\",\n  \"category\": \"SLEEPING_POD\",\n  \"minimumLevel\": \"SILVER\",\n  \"capacity\": 4\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/resources", "host": ["{{baseUrl}}"], "path": ["resources"] }
          },
          "response": []
        },
        {
          "name": "Provision Luxury O2 Pod (PLATINUM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('luxuryO2PodResourceId', pm.response.json().id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Luxury O2 Pods\",\n  \"category\": \"OXYGEN_UNIT\",\n  \"minimumLevel\": \"PLATINUM\",\n  \"capacity\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/resources", "host": ["{{baseUrl}}"], "path": ["resources"] }
          },
          "response": []
        },
        {
          "name": "Decommission Sleeping Pod",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/resources/{{sleepingPodResourceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["resources", "{{sleepingPodResourceId}}"]
            },
            "description": "Expect 204. Run this after 'Use Sleeping Pod (should be granted)' under Passenger Self-Service, then re-run that same request afterward — it should now return 403 even though GOLD still meets the SILVER minimum, since a decommissioned resource denies usage regardless of tier."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Crew Lead — Reports",
      "item": [
        {
          "name": "View Usage by Level",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/reports/usage-by-level",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "usage-by-level"]
            },
            "description": "Run this after the two usage attempts under Passenger Self-Service. Expect one row per membership level that has usage_log activity, each with a granted/denied count — e.g. GOLD should show granted: 1, denied: 1."
          },
          "response": []
        },
        {
          "name": "View Resource Demand",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{crewLeadApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/reports/resource-demand",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "resource-demand"]
            },
            "description": "Run this after the two usage attempts under Passenger Self-Service. Expect both resources ranked by attempts (most-demanded first), each with a granted count — e.g. the Sleeping Pod and Luxury O2 Pod should each show attempts: 1."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Passenger Self-Service",
      "item": [
        {
          "name": "View My Accessible Resources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{passengerApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/passengers/{{passengerId}}/resources",
              "host": ["{{baseUrl}}"],
              "path": ["passengers", "{{passengerId}}", "resources"]
            },
            "description": "As a GOLD passenger, expect the Sleeping Pod (SILVER minimum) to show up here but not the Luxury O2 Pod (PLATINUM minimum)."
          },
          "response": []
        },
        {
          "name": "Use Sleeping Pod (should be granted)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{passengerApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": {{sleepingPodResourceId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/passengers/{{passengerId}}/usage",
              "host": ["{{baseUrl}}"],
              "path": ["passengers", "{{passengerId}}", "usage"]
            },
            "description": "GOLD meets the SILVER minimum, so expect 201 Created, and a GRANTED row written to usage_log."
          },
          "response": []
        },
        {
          "name": "Use Luxury O2 Pod (should be denied at GOLD)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{passengerApiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceId\": {{luxuryO2PodResourceId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/passengers/{{passengerId}}/usage",
              "host": ["{{baseUrl}}"],
              "path": ["passengers", "{{passengerId}}", "usage"]
            },
            "description": "GOLD doesn't meet the PLATINUM minimum, so expect 403 Forbidden — but still a DENIED row written to usage_log with a denial reason (the audit trail records denials too). Run 'Upgrade Passenger to PLATINUM' and retry this request afterward — it should now return 201."
          },
          "response": []
        },
        {
          "name": "View My Usage History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{passengerApiKey}}" }],
            "url": {
              "raw": "{{baseUrl}}/passengers/{{passengerId}}/usage",
              "host": ["{{baseUrl}}"],
              "path": ["passengers", "{{passengerId}}", "usage"]
            },
            "description": "Run this after the two usage attempts above. Expect both entries back, most recent first: a GRANTED row for the Sleeping Pod and a DENIED row (with denial reason) for the Luxury O2 Pod — the audit trail includes denials, not just successes."
          },
          "response": []
        }
      ]
    }
  ]
}
